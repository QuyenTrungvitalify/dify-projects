{
  "yaml.schemas": {
    "./schemas/dify-dsl-0.6.0.json": [
      "templates/patterns/*.yml",
      "templates/_base/**/workflows/*.yml",
      "projects/_drafts/*/workflows/*.yml",
      "projects/_drafts/*/workflows/*.yaml",
      "projects/new/*/workflows/*.yml",
      "projects/new/*/workflows/*.yaml"
    ]
  },
  "yaml.validate": true,
  "yaml.format.enable": true,
  "yaml.completion": true,
  "yaml.hover": true,
  "files.associations": {
    "*.dify.yml": "yaml",
    "*.dify.yaml": "yaml"
  }
}

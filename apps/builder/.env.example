# apps/builder/.env.example — spec 009 Builder backend config (§F).
# Copy to apps/builder/.env (gitignored) and edit. The backend loads this at boot; an explicit
# shell export overrides a value here. `127.0.0.1` bind is HARDCODED (not configurable, §J).

# Repo root the builder operates on (where .venv/, tools/, skills/, projects/ live).
# Optional — defaults to the repo root detected from the server file location.
DIFY_PROJECTS_DIR=

# HTTP port (the ONLY configurable bind knob; host is always 127.0.0.1).
BUILDER_PORT=4123

# ── Timeouts (spec 048 D1) — all in MILLISECONDS, read once at boot (restart after changing) ──────
# Wall-clock budget for ONE claude phase turn (default 15 min, spec 085). Raise if long/complex
# requirements keep timing out at Implement; the timeout error card names the phase that hit it.
# BUILDER_TURN_TIMEOUT_MS=900000
# Budget for an Ask/chat reply (default 8 min, spec 097). Shorter than a phase turn by design — someone
# is watching this one — but 3 min was killing real work: an ask on a large build reads SPEC.md, a ~100KB
# main.yml and report.json before it can answer. Safe to raise only because a cut-off answer now says so
# and Stop is offered on every ask; the lane is one global slot, so this bounds how long a single ask can
# block every other chat.
# BUILDER_ASK_TIMEOUT_MS=480000
# Budget for ONE live workflow run against Dify at the Test phase (default 120 s). Raise for
# iteration-heavy or file-processing workflows whose single run legitimately exceeds 2 minutes.
# BUILDER_LIVE_RUN_TIMEOUT_MS=120000

# ── Ask session size (spec 100) — read once at boot ───────────────────────────────────────────────
# How large a ④/terminal ask conversation may grow before the NEXT question starts a fresh one, in
# tokens (input + cache-read + cache-creation of the previous turn). Default 1,000,000.
#
# LEAVE THIS ALONE UNLESS YOU HAVE A MEASUREMENT. Lowering it looks like the cautious choice and often
# is not: the conversation is what lets the assistant remember the workflow file it already read, so a
# reset makes it read that file again — and on a build with a large main.yml that single re-read is
# 400k+ tokens, which trips the limit again. Measured on a real run: it reset four times in one day,
# twice within eight minutes, and the turn right after a reset still carried 442k tokens. The default
# was raised from 300k precisely because 300k sat BELOW the cost of one ordinary question there.
#
# Raising it is the safe direction; the ceiling is one heavy turn, not an unbounded conversation.
# Lowering it only helps the opposite shape — a SMALL workflow file with a very long conversation,
# where the history really is the bulk. A value under 50,000 is raised to 50,000 rather than obeyed
# (a fresh session already carries ~27k of preamble, so a limit below that resets every single turn).
#
# The app cannot see which Claude plan the account is on, so this is the knob for it — per machine,
# which is exactly the granularity "whose account is this" needs.
# BUILDER_ASK_RESET_TOKENS=1000000

# ── Dify console credentials — BACKEND-ONLY (§F/§J) ───────────────────────────────────────────────
# Needed ONLY for deploy=selfhost (Phase ④ import) or seeding from a live Dify app (/api/seeds + pull).
# Leave commented for deploy=none. The token is injected ONLY into the backend's own `sync.py`
# subprocess; it NEVER enters a claude turn (stripped from the turn env), the SSE stream, or .runs JSON.
#
# DIFY_CONSOLE_TOKEN accepts EITHER:
#   A) a browser-session JWT (quick, but expires ~60m) — DevTools → Network → copy the
#      `Authorization: Bearer <TOKEN>` header of any /console/api call. Leave DIFY_WORKSPACE_ID unset.
#   B) an ADMIN_API_KEY (stable, does NOT expire — recommended for long-term self-host). Enable it in
#      the Dify docker `.env` (ADMIN_API_KEY_ENABLE=true + ADMIN_API_KEY=<key>, restart `api`), put the
#      key here, AND set DIFY_WORKSPACE_ID=<tenant id> — the admin-key path REQUIRES it (sent as the
#      X-WORKSPACE-ID header). Get the tenant id from GET /console/api/workspaces/current → `id`.
#
#   DIFY_CONSOLE_URL   = https://<host>/console/api   (e.g. http://localhost/console/api)
#   DIFY_CONSOLE_TOKEN = <session JWT (A) OR ADMIN_API_KEY (B)>
#   DIFY_WORKSPACE_ID  = <tenant/workspace id — REQUIRED only for the ADMIN_API_KEY path (B)>
# DIFY_CONSOLE_URL=
# DIFY_CONSOLE_TOKEN=
# DIFY_WORKSPACE_ID=

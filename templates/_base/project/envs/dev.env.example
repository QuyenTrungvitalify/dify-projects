# Dev environment config for {{project_name}}.
# Copy to dev.env and fill in. dev.env is gitignored — never commit it.

# Workspace this project targets in dev.
# IMPORTANT: include the /v1 suffix — the test harness calls /workflows/run, /files/upload, etc.
# Examples:
#   Dify Cloud:      https://api.dify.ai/v1
#   Self-host:       https://dify.yourcompany.com/v1
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-xxxxxxxxxxxx
DIFY_CONSOLE_TOKEN=
DIFY_APP_ID=

# External services this project uses (uncomment as needed)
# DEEPL_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

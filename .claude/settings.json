{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(curl *)",
      "Bash(cp *)",
      "Bash(mv *)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/Desktop/MyProjects/claude-nexus/dist/hooks/permission-gate.js",
            "timeout": 1860
          }
        ]
      }
    ]
  }
}
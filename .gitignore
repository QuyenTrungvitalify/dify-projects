# Auto-generated index — rebuild with `python3 tools/dify_base/build_index.py`
tools/dify_base/index.json

# External clones (re-clone if needed)
skills/*/
corpus/*/
vendor/

# But keep .gitkeep placeholders
!skills/.gitkeep
!corpus/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
.idea/
# (Note: .vscode/settings.json IS committed — wires up YAML schema for the team)

# Spec 009 Lát-0 spike (throwaway)
spike/

# Spec 009 builder app (apps/builder) — Node toolchain, build output, run artifacts, secrets.
# The real .env (DIFY_CONSOLE_TOKEN etc.) is gitignored; .env.example IS committed.
# `**` so the nested web/ package (apps/builder/web/) is covered too, not just apps/builder/.
apps/**/node_modules/
apps/**/dist/
apps/*/.runs/
apps/*/.env*
!apps/*/.env.example
# Stray repo-root run dir (a turn writes `.runs/<taskId>/`; the backend relocates these into
# apps/builder/.runs/ — see orchestrator.relocateRunArtifacts — but the empty/leftover root one is junk).
/.runs/

# Builder QA scratch projects (spec 011 R2): the builder writes each QA run's output to
# projects/<derived-slug>/. These are regenerable throwaways — gitignored so they don't pollute the
# repo or the generated INDEX.md (build_index.py skips gitignored YAMLs). Real hand-made projects
# (news_automation/, eiken_stem_proofread/) are NOT matched and stay tracked/indexable.
projects/workflow_*/
projects/start_1_llm_node/
projects/test/

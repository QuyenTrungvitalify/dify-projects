# Node dependencies — never committed
node_modules/
# Repo-pinned node/python/uv (spec 110 S1). Never committed; `rm -rf .toolchain` is a full uninstall.
.toolchain/

# Auto-generated index — rebuild with `python3 tools/dify_base/build_index.py`
tools/dify_base/index.json

# Per-machine dev-mode marker (spec 080): update-and-run.command starts with BUILDER_DEV=1 + ?dev=1
# when this file exists. Local only — never commit it, so other users' launches stay non-dev.
.builder-dev

# External clones (re-clone if needed)
skills/*/
corpus/*/
vendor/

# But keep .gitkeep placeholders
!skills/.gitkeep
!corpus/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
.idea/
# (Note: .vscode/settings.json IS committed — wires up YAML schema for the team)

# Spec 083 dev Settings — per-machine overrides (drop URL/secret, display name). The team default
# .dify-share.json IS committed; this local override file is NOT (secrets + per-user, never a diff).
.dify-settings.local.json

# Spec 009 Lát-0 spike (throwaway)
spike/

# Spec 009 builder app (apps/builder) — Node toolchain, build output, run artifacts, secrets.
# The real .env (DIFY_CONSOLE_TOKEN etc.) is gitignored; .env.example IS committed.
# `**` so the nested web/ package (apps/builder/web/) is covered too, not just apps/builder/.
apps/**/node_modules/
apps/**/dist/
apps/*/.runs/
apps/*/.env*
!apps/*/.env.example
# Stray repo-root run dir (a turn writes `.runs/<taskId>/`; the backend relocates these into
# apps/builder/.runs/ — see orchestrator.relocateRunArtifacts — but the empty/leftover root one is junk).
/.runs/

# Builder scratch under projects/ is NO LONGER ignored (spec 112). It was, via two patterns:
# `projects/_drafts/` (spec 011 R2 / spec 030) and `projects/*/workflow_*/`.
#
# The ignore turned out to be load-bearing in a way it never advertised. `confinementCheck` polices
# cross-workflow writes through `git status`, which cannot see an ignored path — so `_drafts`, where
# nearly every real run lives, was the ONE place a turn could scribble into a NEIGHBOURING workflow
# unseen. Run 1787273481220 rode that blind spot for $19.25 with its gate still reporting `success`.
# Ignoring also made `git clean -fd` skip the area, so a breach could not be undone even once noticed.
# Tracking turns both back on. What stays open until the drafts are actually COMMITTED: an in-place
# OVERWRITE of a neighbour is baseline-covered and still invisible — only newly-created strays are
# caught (pinned in apps/builder/test/confinement.test.ts).
#
# BOTH patterns go, not just the first: 4 of the 23 drafts are named `workflow_*` (slug.ts derives
# slugs from the requirement, so the collision recurs), and leaving the depth-2 pattern would have
# kept exactly those in the blind spot while the change appeared to close it.
# Keeping drafts out of the generated INDEX.md is now build_index.py's job, done by NAME in
# collect_entries() — which is what the exclusion always MEANT; it merely borrowed `git check-ignore`
# to say it.

# Ad-hoc build-output / phase-transcript dumps saved at repo root (scratch — never committed).
# Root-anchored so tracked files like requirements.txt / assets/*.txt are unaffected.
/analysic.txt
/run_after*.txt
/test_*.txt

# Scratch files written by throwaway analysis/verification runs, never by the app. Named so they are
# obvious in `git status` — but a directory-wide `git add` sweeps them in anyway, which has already
# put one into a commit (a tsconfig whose outDir pointed at a machine-local scratchpad). Ignoring them
# is cheaper than remembering to stage by intent every time.
**/zz-*.test.ts
**/__audit*
apps/builder/tsconfig.*.json
!apps/builder/tsconfig.test.json

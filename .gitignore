# Node dependencies — never committed
node_modules/
# Repo-pinned node/python/uv (spec 110 S1). Never committed; `rm -rf .toolchain` is a full uninstall.
.toolchain/

# Auto-generated index — rebuild with `python3 tools/dify_base/build_index.py`
tools/dify_base/index.json

# Per-machine dev-mode marker (spec 080): update-and-run.command starts with BUILDER_DEV=1 + ?dev=1
# when this file exists. Local only — never commit it, so other users' launches stay non-dev.
.builder-dev

# Per-machine Claude Code state — never committed (spec 116).
#   - the repo-root settings file carried a PreToolUse hook pointing at an absolute path in ANOTHER
#     repo on the author's machine; on anyone else's clone that file does not exist, so the hook
#     failed on every tool call. The Builder does NOT depend on it — its turns run under
#     apps/builder/headless-settings.json + apps/builder/server/hooks/permission-gate.ts.
#     Personal overrides belong in .claude/settings.local.json, which was already never tracked.
#   - .claude/projects/ is Claude Code's per-project store keyed by the ABSOLUTE cwd, so the
#     directory name itself is the author's home path.
.claude/settings.json
.claude/projects/

# External clones (re-clone if needed)
skills/*/
corpus/*/
vendor/

# But keep .gitkeep placeholders
!skills/.gitkeep
!corpus/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
.idea/
# (Note: .vscode/settings.json IS committed — wires up YAML schema for the team)

# Spec 083 dev Settings — per-machine overrides (drop URL/secret, display name). The team default
# .dify-share.json IS committed; this local override file is NOT (secrets + per-user, never a diff).
.dify-settings.local.json

# Spec 009 Lát-0 spike (throwaway)
spike/

# Spec 009 builder app (apps/builder) — Node toolchain, build output, run artifacts, secrets.
# The real .env (DIFY_CONSOLE_TOKEN etc.) is gitignored; .env.example IS committed.
# `**` so the nested web/ package (apps/builder/web/) is covered too, not just apps/builder/.
apps/**/node_modules/
apps/**/dist/
apps/*/.runs/
apps/*/.env*
!apps/*/.env.example
# Stray repo-root run dir (a turn writes `.runs/<taskId>/`; the backend relocates these into
# apps/builder/.runs/ — see orchestrator.relocateRunArtifacts — but the empty/leftover root one is junk).
/.runs/

# Builder scratch under projects/: `projects/_drafts/` (spec 011 R2 / spec 030) and the depth-2
# `projects/*/workflow_*/`. Ignored — and this pair went out and came back, so the round trip is
# written down rather than left for someone to repeat.
#
# Spec 112 UN-ignored them. `confinementCheck` polices cross-workflow writes through `git status`,
# which cannot see an ignored path, so `_drafts` — where nearly every build runs — was the one place a
# turn could scribble into a neighbouring workflow unseen. Run 1787273481220 rode that for $19.25 with
# its gate reporting `success`.
#
# Spec 114 put them back, because the price was three things and the goods were already on the shelf:
#   - `git status` is permanently dirty on every user's clone, from their first build onward;
#   - `git add -A` sweeps megabytes of scratch into a commit;
#   - and the sharp one: every project folder gets a generated README.md, so
#     `projects/_drafts/README.md` exists untracked on EVERY machine. Commit that path once upstream
#     and every user's `git pull --ff-only` aborts with "untracked working tree files would be
#     overwritten". Measured, not feared.
# Meanwhile `strayWrites` (spec 111) already detected these writes WITHOUT git, by mtime, and catches
# the in-place overwrite git could not see either way. What un-ignoring uniquely bought was git's
# revert - which spec 111 had already declined, since with nothing committed a revert is a delete.
# Spec 114 takes the third option: a stray workflow YAML now FAILS the phase (orchestrator.ts). The
# file stays put for a human to move, and the gate stops calling it success.
#
# Also tried and rejected: `git status --ignored=matching`, to keep the ignore AND let confinement
# look. Git collapses an ignored directory to ONE entry (`!! projects/_drafts/`), and a narrower
# `projects/_drafts/**` only collapses a level lower - so a new file inside an existing folder yields
# the same string before and after the turn, sits in `baseline`, and is never a delta. Unusable.
#
# Keeping drafts out of the generated INDEX.md no longer rides on this: build_index.py excludes them
# by NAME (`DRAFTS_DIR` in collect_entries), which is what the exclusion always meant.
projects/_drafts/
projects/*/workflow_*/

# Ad-hoc build-output / phase-transcript dumps saved at repo root (scratch — never committed).
# Root-anchored so tracked files like requirements.txt / assets/*.txt are unaffected.
/analysic.txt
/run_after*.txt
/test_*.txt

# Scratch files written by throwaway analysis/verification runs, never by the app. Named so they are
# obvious in `git status` — but a directory-wide `git add` sweeps them in anyway, which has already
# put one into a commit (a tsconfig whose outDir pointed at a machine-local scratchpad). Ignoring them
# is cheaper than remembering to stage by intent every time.
**/zz-*.test.ts
**/__audit*
apps/builder/tsconfig.*.json
!apps/builder/tsconfig.test.json

# ── Vùng phát triển: đã chuyển sang repo private `dify-projects-doc` (spec 116) ──────────────
# KHÔNG có dấu `/` cuối: các path này là SYMLINK trên máy maintainer, và `docs/specs/` (có `/`)
# không khớp một symlink — git vẫn báo `?? docs/specs`. Đo được, đừng "sửa lại cho nhất quán".
# Máy user: các path này đơn giản không tồn tại. Không code nào đọc chúng lúc chạy (spec 116 §1.4).
.doc
docs/specs
docs/prompts
docs/state
docs/watch
tests/test_state_docs_ownership.py
.claude/skills/campaign
.claude/skills/corpus-update
.claude/skills/e2e
.claude/skills/report
.claude/skills/scout
.claude/skills/shelf-inbox
.claude/skills/spec-close
.claude/skills/template-promote

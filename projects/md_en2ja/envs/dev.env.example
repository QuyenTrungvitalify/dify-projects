# Dev environment config for Markdown EN→JA Translator.
# Copy to dev.env and fill in. dev.env is gitignored — never commit it.

# =========================================================================
# Public API (used by tests/conftest.py → DifyWorkflowClient)
# =========================================================================
# IMPORTANT: include the /v1 suffix — DifyWorkflowClient calls /workflows/run,
# /files/upload directly, so base_url + /workflows/run must be the final URL.
#
#   Dify Cloud:      https://api.dify.ai/v1
#   Self-host:       https://dify.yourcompany.com/v1
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-xxxxxxxxxxxx
DIFY_APP_ID=

# =========================================================================
# Console API (used by tools/dify_base/sync.py for GitOps pull/push/diff)
# =========================================================================
# Different from public API. NO /v1 suffix — ends with /console/api.
#   Dify Cloud:      https://cloud.dify.ai/console/api
#   Self-host:       https://dify.yourcompany.com/console/api
#
# Get DIFY_CONSOLE_TOKEN from a logged-in browser session:
#   1. Open Dify in browser, log in
#   2. DevTools → Network → click any /console/api/... request
#   3. Copy the `Authorization: Bearer <TOKEN>` header value
# Tokens are session-scoped — refresh when sync.py starts returning 401.
DIFY_CONSOLE_URL=https://cloud.dify.ai/console/api
DIFY_CONSOLE_TOKEN=

# =========================================================================
# External services this project uses (uncomment as needed)
# =========================================================================
# DEEPL_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
